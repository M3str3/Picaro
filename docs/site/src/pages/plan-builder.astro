---
/**
 * Interactive plan builder — a custom Astro route (not a Markdown page).
 *
 * Linked from docs/nav.yml as /plan-builder/. The technique catalogue is
 * generated by scripts/assemble-docs.mjs into /plan-catalog.json from each
 * src/techniques/<name>/mod.rs, so new techniques appear after the next assemble.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import PlanBuilder from '../components/PlanBuilder.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Plan builder',
    description: 'Compose a schema-6 YAML plan without memorising technique knobs.',
    template: 'doc',
    tableOfContents: false,
    prev: false,
    next: false,
  }}
>
  <PlanBuilder />
</StarlightPage>
