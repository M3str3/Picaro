---
/**
 * In-docs plan builder.
 *
 * Wide two-column page: the plan on the left, the YAML on the right.
 * Techniques are picked from a large modal with a section sidebar
 * (preparation / execution / control). The catalogue is /plan-catalog.json.
 */
---

<div class="pb" id="pb-root" data-pb>
  <header class="pb-top">
    <p class="pb-lede">
      Build the chain from the registry. A new directory under
      <code>src/techniques/</code> shows up after the next docs assemble.
    </p>
    <p class="pb-meta" data-meta></p>
  </header>

  <div class="pb-board">
    <div class="pb-compose">
      <section class="pb-section" aria-labelledby="pb-payload-label">
        <h2 id="pb-payload-label" class="pb-kicker">Payload</h2>
        <div class="pb-card" data-payload></div>
      </section>

      <section class="pb-section" aria-labelledby="pb-chain-label">
        <div class="pb-section-head">
          <h2 id="pb-chain-label" class="pb-kicker">Chain</h2>
          <span class="pb-count" data-count></span>
        </div>
        <ol class="pb-chain" data-chain></ol>
        <button type="button" class="pb-add" data-open-picker>Add a technique</button>
        <div class="pb-notes" data-notes></div>
      </section>

      <details class="pb-fold">
        <summary>Build settings <span>output and loader</span></summary>
        <div class="pb-fold-body" data-settings></div>
      </details>
    </div>

    <aside class="pb-yaml-col" aria-labelledby="pb-yaml-label">
      <div class="pb-yaml-card">
        <div class="pb-yaml-head">
          <h2 id="pb-yaml-label" class="pb-kicker">plan.yaml</h2>
        </div>
        <div class="pb-pair">
          <button type="button" class="pb-btn pb-btn-ghost" data-copy>Copy</button>
          <button type="button" class="pb-btn" data-download>Download</button>
        </div>
        <pre class="pb-yaml" data-yaml tabindex="0"></pre>
        <p class="pb-plan-foot">Check it with <code>picaro build --dry-run plan.yaml</code></p>
      </div>
    </aside>
  </div>

  <dialog class="pb-dialog" data-picker aria-labelledby="pb-picker-label">
    <form method="dialog" class="pb-dialog-form">
      <header class="pb-dialog-head">
        <h2 id="pb-picker-label">Add a technique</h2>
        <button type="submit" class="pb-icon" value="cancel" aria-label="Close">×</button>
      </header>
      <div class="pb-dialog-body">
        <nav class="pb-dialog-nav" data-picker-nav aria-label="Technique sections"></nav>
        <div class="pb-dialog-main">
          <input
            type="search"
            class="pb-search"
            data-picker-search
            placeholder="Filter this section…"
            aria-label="Filter techniques"
            autocomplete="off"
          />
          <div class="pb-picker-grid" data-picker-list></div>
        </div>
      </div>
    </form>
  </dialog>

  <div class="pb-toast" data-toast role="status"></div>
</div>

<style is:global>
  :root:has(#pb-root) {
    --sl-content-width: 100%;
  }

  .pb {
    --pb-line: var(--sl-color-gray-5);
    --pb-muted: var(--sl-color-gray-3);
    --pb-surface: var(--sl-color-gray-6, var(--sl-color-bg-nav));
    --pb-ok: #2f8f62;
    --pb-warn: #a16207;
    --pb-err: #b42318;
    --pb-h: 2.5rem;
    margin: 0.25rem 0 2rem;
    color: inherit;
  }

  .pb-top { margin-bottom: 1.25rem; }
  .pb-lede {
    margin: 0 0 0.3rem;
    max-width: 46rem;
    color: var(--sl-color-gray-2);
    line-height: 1.55;
  }
  .pb-meta {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: var(--pb-muted);
  }

  .pb-board {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(22rem, 0.8fr);
    gap: 1.5rem;
    align-items: start;
  }

  .pb-section { margin: 0 0 1.25rem; }
  .pb-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--pb-h);
    margin-bottom: 0.5rem;
  }
  .pb-kicker {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
    line-height: 1;
  }
  .pb-count {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: var(--pb-muted);
  }

  .pb-card,
  .pb-step-card,
  .pb-fold,
  .pb-yaml-card,
  .pb-dialog {
    border: 1px solid var(--pb-line);
    border-radius: 12px;
    background: var(--pb-surface);
  }

  .pb-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(8rem, 0.6fr) minmax(0, 0.9fr);
    gap: 0.75rem 1rem;
    padding: 1rem;
    align-items: end;
  }
  .pb-span-2 { grid-column: span 2; }
  .pb-span-3 { grid-column: 1 / -1; }

  .pb-field {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.3rem;
    min-width: 0;
    margin: 0;
  }
  .pb-field > span {
    font-family: var(--sl-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pb-muted);
    line-height: 1;
  }
  .pb input[type='text'],
  .pb input[type='number'],
  .pb input[type='search'],
  .pb select,
  .pb-add,
  .pb-btn {
    box-sizing: border-box;
    height: var(--pb-h);
    margin: 0;
  }
  .pb input[type='text'],
  .pb input[type='number'],
  .pb input[type='search'],
  .pb select {
    width: 100%;
    appearance: none;
    border: 1px solid var(--pb-line);
    border-radius: 8px;
    background: var(--sl-color-bg);
    color: inherit;
    font-family: var(--sl-font-mono);
    font-size: 0.84rem;
    padding: 0 0.7rem;
    outline: none;
  }
  .pb input:focus,
  .pb select:focus {
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--sl-color-accent) 25%, transparent);
  }
  .pb select {
    background-image:
      linear-gradient(45deg, transparent 50%, var(--sl-color-accent) 50%),
      linear-gradient(135deg, var(--sl-color-accent) 50%, transparent 50%);
    background-position: calc(100% - 14px) 50%, calc(100% - 9px) 50%;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    padding-right: 1.6rem;
  }

  .pb-toggles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    min-height: var(--pb-h);
  }
  .pb-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: var(--pb-h);
    box-sizing: border-box;
    font-size: 0.82rem;
    border: 1px solid var(--pb-line);
    border-radius: 8px;
    padding: 0 0.75rem;
    background: var(--sl-color-bg);
    cursor: pointer;
    color: var(--sl-color-gray-2);
    margin: 0;
  }
  .pb-toggle:has(input:checked) {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
    background: var(--sl-color-accent-low);
  }
  .pb-toggle input { accent-color: var(--sl-color-accent); margin: 0; }
  .pb-hint {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    color: var(--pb-muted);
    line-height: 1.4;
  }

  .pb-chain {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .pb-step { margin: 0; }
  .pb-step-card { padding: 0.8rem 0.9rem; }
  .pb-step-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }
  .pb-step-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
    min-width: 0;
    min-height: 2rem;
  }
  .pb-step-title strong { font-size: 0.98rem; font-weight: 650; }
  .pb-badge {
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pb-muted);
    border: 1px solid var(--pb-line);
    border-radius: 999px;
    padding: 0.12rem 0.45rem;
    background: var(--sl-color-bg);
    line-height: 1.2;
  }
  .pb-id {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: var(--pb-muted);
  }
  .pb-doc { font-size: 0.75rem; color: var(--sl-color-text-accent); }
  .pb-blurb {
    margin: 0.4rem 0 0;
    font-size: 0.84rem;
    color: var(--sl-color-gray-2);
    line-height: 1.45;
  }
  .pb-step-tools {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  /* `.pb` raises specificity above Starlight's sibling margin inside
     `.sl-markdown-content`, which otherwise drops every button after the first. */
  .pb .pb-icon {
    width: 2rem;
    height: 2rem;
    flex: none;
    box-sizing: border-box;
    margin: 0;
    border: 1px solid var(--pb-line);
    border-radius: 8px;
    background: var(--sl-color-bg);
    color: var(--pb-muted);
    cursor: pointer;
    font: inherit;
    line-height: 1;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .pb-icon:hover:not(:disabled) { color: inherit; border-color: var(--sl-color-gray-2); }
  .pb-icon:disabled { opacity: 0.35; cursor: default; }
  .pb-icon.is-danger:hover { color: var(--pb-err); border-color: var(--pb-err); }

  .pb-params {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.65rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--pb-line);
    align-items: end;
  }
  .pb-step-note { margin: 0.5rem 0 0; font-size: 0.78rem; color: var(--pb-warn); }
  .pb-step-note.is-err { color: var(--pb-err); }
  .pb-empty {
    margin: 0;
    padding: 1rem;
    border: 1px dashed var(--pb-line);
    border-radius: 12px;
    color: var(--pb-muted);
    font-size: 0.9rem;
  }

  .pb-add {
    font: inherit;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--sl-color-text-accent);
    background: transparent;
    border: 1px dashed var(--sl-color-accent);
    border-radius: 8px;
    padding: 0 1rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .pb-add:hover { background: var(--sl-color-accent-low); }

  .pb-notes { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.75rem; }
  .pb-note {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.4;
    border-radius: 8px;
    padding: 0.55rem 0.75rem;
    border: 1px solid color-mix(in oklab, var(--pb-warn) 35%, var(--pb-line));
    background: color-mix(in oklab, var(--pb-warn) 10%, transparent);
  }
  .pb-note.is-err {
    border-color: color-mix(in oklab, var(--pb-err) 40%, var(--pb-line));
    background: color-mix(in oklab, var(--pb-err) 10%, transparent);
  }

  .pb-fold { background: transparent; }
  .pb-fold summary {
    cursor: pointer;
    font-weight: 650;
    min-height: var(--pb-h);
    padding: 0 0.9rem;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .pb-fold summary::-webkit-details-marker { display: none; }
  .pb-fold summary span { font-weight: 450; font-size: 0.8rem; color: var(--pb-muted); }
  .pb-fold-body { padding: 0 0.9rem 1rem; }
  .pb-settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.25rem;
    align-items: start;
  }
  .pb-settings-grid h3 {
    margin: 0 0 0.65rem;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pb-muted);
  }
  .pb-settings-grid .pb-grid { padding: 0; grid-template-columns: 1fr 1fr; }

  .pb-yaml-col { position: sticky; top: 1rem; }
  .pb-yaml-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.85rem;
  }
  .pb-yaml-head {
    display: flex;
    align-items: center;
    min-height: 1.25rem;
  }
  .pb-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .pb-btn {
    font: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    border-radius: 8px;
    border: 1px solid var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    padding: 0 0.75rem;
    cursor: pointer;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .pb-btn:hover { filter: brightness(1.06); }
  .pb-btn-ghost {
    background: transparent;
    color: var(--sl-color-text-accent);
  }
  .pb-yaml {
    margin: 0;
    padding: 0.9rem 1rem;
    overflow: auto;
    max-height: min(70vh, 40rem);
    min-height: 16rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    line-height: 1.55;
    white-space: pre;
    tab-size: 2;
    border-radius: 8px;
    background: var(--sl-color-bg);
    border: 1px solid var(--pb-line);
  }
  .pb-yaml .tok-key { color: var(--sl-color-text-accent); }
  .pb-yaml .tok-str { color: var(--pb-ok); }
  .pb-yaml .tok-num { color: var(--pb-warn); }
  .pb-yaml .tok-bool { color: #5b7fbf; }
  .pb-yaml .tok-cmt { color: var(--pb-muted); font-style: italic; }
  .pb-plan-foot { margin: 0; font-size: 0.78rem; color: var(--pb-muted); }

  .pb-dialog[open] {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(68rem, calc(100vw - 2rem));
    height: min(40rem, calc(100vh - 2.5rem));
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 2.5rem);
    padding: 0;
    color: inherit;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 24px 60px color-mix(in oklab, #000 28%, transparent);
  }
  .pb-dialog::backdrop {
    background: color-mix(in oklab, var(--sl-color-black, #000) 45%, transparent);
  }
  .pb-dialog-form {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    margin: 0;
  }
  .pb-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.25rem;
    padding: 0 0.85rem 0 1.1rem;
    border-bottom: 1px solid var(--pb-line);
    flex: none;
  }
  .pb-dialog-head h2 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: 0;
    text-transform: none;
    color: inherit;
  }
  .pb-dialog-body {
    display: grid;
    grid-template-columns: 14.5rem minmax(0, 1fr);
    min-height: 0;
    flex: 1;
  }
  .pb-dialog-nav {
    border-right: 1px solid var(--pb-line);
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .pb-sec {
    height: 2.75rem;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0 0.75rem;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
  }
  .pb-sec:hover { background: color-mix(in oklab, var(--sl-color-accent) 8%, transparent); }
  .pb-sec.is-on {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-accent);
  }
  .pb-sec-count {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--pb-muted);
  }
  .pb-sec.is-on .pb-sec-count { color: var(--sl-color-text-accent); }
  .pb-dialog-main {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    padding: 0.75rem 0.85rem 0.85rem;
    gap: 0.65rem;
  }
  .pb-dialog-main .pb-search { flex: none; }
  .pb-picker-grid {
    overflow: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    align-content: start;
    align-items: stretch;
    padding-right: 0.15rem;
  }
  .pb-tech {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    min-height: 8.25rem;
    height: 100%;
    margin: 0;
    padding: 0.8rem 0.85rem;
    text-align: left;
    border: 1px solid var(--pb-line);
    border-radius: 10px;
    background: var(--sl-color-bg);
    color: inherit;
    cursor: pointer;
    font: inherit;
  }
  .pb-tech:hover { border-color: var(--sl-color-accent); }
  .pb-tech strong { font-weight: 650; font-size: 0.95rem; }
  .pb-tech code {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: var(--pb-muted);
  }
  .pb-tech small {
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .pb-none {
    grid-column: 1 / -1;
    margin: 0.5rem 0;
    color: var(--pb-muted);
    font-size: 0.9rem;
  }

  .pb-toast {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 80;
    font-size: 0.82rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-accent);
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
  }
  .pb-toast.is-on { opacity: 1; transform: none; }
  .pb-error {
    padding: 0.8rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--pb-err);
    color: var(--pb-err);
  }

  @media (max-width: 960px) {
    .pb-board { grid-template-columns: 1fr; }
    .pb-yaml-col { position: static; }
    .pb-grid { grid-template-columns: 1fr 1fr; }
    .pb-span-2, .pb-span-3 { grid-column: 1 / -1; }
    .pb-settings-grid { grid-template-columns: 1fr; }
    .pb-dialog[open] { width: calc(100vw - 1rem); height: calc(100vh - 1rem); }
    .pb-dialog-body { grid-template-columns: 1fr; }
    .pb-dialog-nav { flex-direction: row; border-right: 0; border-bottom: 1px solid var(--pb-line); }
    .pb-sec { flex: 1; }
    .pb-picker-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-toast { transition: none; }
  }
</style>

<script>
  import { mount } from './plan-builder/app.js';

  const root = document.getElementById('pb-root');
  if (root) mount(root);
</script>
