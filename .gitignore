# Local scratch: reference material kept out of the project.
code_examples/
/payload_decrypted.bin

# Local session memory: a rolling developer note, not part of the repo.
.memory.md

# Host build output.
/target
/build
/dist

# Lab
/lab

# Documentation site output (MkDocs).
/site

# Python bytecode cache (the host examples are Python scripts).
__pycache__/

# .NET host example build output (`dotnet run`).
examples/hosts/dotnet_host/bin/
examples/hosts/dotnet_host/obj/

# Debug symbols and linker side artifacts (MSVC + MinGW).
*.pdb
*.ilk
*.exp
*.exe

# Signing material: never commit a private key or certificate.
*.pfx
*.p12
*.pem
*.key

# Build side-outputs written next to an artifact (see docs/architecture.md).
*.ca.cer
*.manifest.json

# Lab signing identity (CA + leaf) generated for `output.sign.mode: lab`.
**/.picaro/

# Keep the checked-in test payloads and PE fixtures (all of them are read by
# tests or named by an example plan, so a fresh clone must have them).
!examples/payloads/test_payload.exe
!examples/payloads/test_payload_x86.exe
!tests/fixtures/minimal_x64.exe
!tests/fixtures/minimal_x86.exe
!tests/fixtures/managed_x86.exe
!tests/fixtures/managed_anycpu.exe
