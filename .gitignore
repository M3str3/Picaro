hidden/

# `picaro pack` output: every run writes its plan, manifest and artifact here.
/packed/

# Local agent sessions and scratch, never part of the project.
/.agent-xenon/
/base64.txt
/metrics.json
/x.ps1
/xenon-tls-handoff.md

# The experimental workspace is published to its own repository.
/experimental/

# Local scratch: reference material kept out of the project.
code_examples/
# Local session memory: a rolling developer note, not part of the repo.
.memory.md

# Local working notes: plans, prompts and scratch — never published.
.plan*.md

# Host build output.
/target
/build
/dist

# Lab
/lab

# Documentation site output.
/site

# Documentation site (Astro + Starlight) build artifacts and generated sources.
/docs/site/node_modules/
/docs/site/.astro/
/docs/site/dist/
/docs/site/src/content/docs/
/docs/site/src/sidebar.mjs
/docs/site/src/techniques.generated.mjs
/docs/site/public/plan-catalog.json
/docs/site/public/techniques.json

# Development container exchange folder (docker-compose.yml): the one host folder
# shared writable with the containers — msfvenom payloads, plans and packed
# artifacts go here. Keep the directory itself so a fresh clone has somewhere to
# point the bind mount.
/exchange/*
!/exchange/.gitkeep

# CA material for a corporate TLS-inspecting proxy (PICARO_EXTRA_CA); a trust
# anchor must never be committed.
/certs/

# Python bytecode cache (the host examples are Python scripts).
__pycache__/

# .NET host example build output (`dotnet run`).
examples/hosts/dotnet_host/bin/
examples/hosts/dotnet_host/obj/

# Debug symbols and linker side artifacts (MSVC + MinGW).
*.pdb
*.ilk
*.exp
*.exe
*.dll
*.bin

# Signing material: never commit a private key or certificate.
*.pfx
*.p12
*.pem
*.key

# Build side-outputs written next to an artifact (see docs/architecture.md).
*.ca.cer
*.manifest.json

# Lab signing identity (CA + leaf) generated for `output.sign.mode: lab`.
**/.picaro/

# Keep the checked-in test payloads and PE fixtures (all of them are read by
# tests or named by an example plan, so a fresh clone must have them).
!examples/payloads/msgbox.exe
!examples/payloads/test_payload.exe
!examples/payloads/test_payload_x86.exe
!tests/fixtures/minimal_x64.exe
!tests/fixtures/minimal_x86.exe
!tests/fixtures/managed_x86.exe
!tests/fixtures/managed_anycpu.exe
