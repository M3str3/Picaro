# Build context hygiene: keep the image context to what the build needs.
# Everything listed here is either gitignored, huge, or irrelevant to compiling.

.git
.gitignore
.memory.md

# Host build artifacts (the image builds its own under /usr/src/picaro/target).
target
build
dist

# Docs site output.
site

# Reference material and notes; not compiled into the tool.
code_examples
# The docs Markdown sources are not part of the tool image, but the docs/site
# project under docs/site/ IS the build context for the documentation image, so
# exclude docs/ wholesale and re-include just that project (its own node_modules
# and dist stay out of the context).
docs/*
!docs/site
docs/site/node_modules
docs/site/dist
docs/site/.astro
docs/site/src/content
docs/site/src/sidebar.mjs

# Local scratch artifacts (see .gitignore).
*.pdb
*.ilk
*.exp

# Development container exchange folder (docker-compose.yml): payloads and plans
# belong on the host, not baked into the image.
exchange
